+    "%sql\n",
+    "USE CATALOG `buildabida-capstone`;\n",
+    "CREATE SCHEMA IF NOT EXISTS `02-silver`;\n",
+    "\n",
+    "DECLARE OR REPLACE VARIABLE ncr_region_code STRING DEFAULT '1300000000';\n",
+    "DECLARE OR REPLACE VARIABLE reporting_area_rule_version STRING\n",
